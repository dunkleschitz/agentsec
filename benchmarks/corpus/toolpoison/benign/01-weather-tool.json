{
  "tools": [
    {
      "name": "get_weather",
      "description": "Return the current weather for a city.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "City name, e.g. Boston"
          },
          "units": {
            "type": "string",
            "enum": [
              "metric",
              "imperial"
            ],
            "default": "metric"
          }
        }
      }
    }
  ]
}

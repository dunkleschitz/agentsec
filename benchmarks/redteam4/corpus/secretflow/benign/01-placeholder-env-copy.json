{
  "messages": [
    {
      "role": "system",
      "content": "You are a helpful agent with tools."
    },
    {
      "role": "user",
      "content": "Start a new env file."
    },
    {
      "role": "assistant",
      "content": null,
      "tool_calls": [
        {
          "id": "call_001",
          "type": "function",
          "function": {
            "name": "read_file",
            "arguments": "{\"path\": \".env.example\"}"
          }
        }
      ]
    },
    {
      "role": "tool",
      "tool_call_id": "call_001",
      "name": "read_file",
      "content": "API_KEY=your-api-key-here\n"
    },
    {
      "role": "assistant",
      "content": null,
      "tool_calls": [
        {
          "id": "call_002",
          "type": "function",
          "function": {
            "name": "write_file",
            "arguments": "{\"path\": \".env\", \"content\": \"API_KEY=your-api-key-here\\n\"}"
          }
        }
      ]
    },
    {
      "role": "tool",
      "tool_call_id": "call_002",
      "name": "write_file",
      "content": "ok"
    }
  ]
}

{
  "inputs": [
    {
      "type": "promptString",
      "id": "search-key",
      "description": "Search API key",
      "password": true
    }
  ],
  "servers": {
    "search": {
      "type": "http",
      "url": "https://mcp.search-vendor.io/mcp",
      "headers": {
        "X-Api-Key": "${input:search-key}"
      }
    }
  }
}

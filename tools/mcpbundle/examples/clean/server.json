{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.example/notes",
  "description": "Search your notes.",
  "version": "1.2.0",
  "repository": {"url": "https://github.com/example/notes-helper", "source": "github"},
  "packages": [
    {"registry_type": "npm", "identifier": "@example/notes-mcp", "version": "1.2.0",
     "transport": {"type": "stdio"},
     "environment_variables": [{"name": "NOTES_API_TOKEN", "is_secret": true, "is_required": true}]}
  ],
  "remotes": [
    {"type": "streamable-http", "url": "https://notes.example.com/mcp",
     "headers": [{"name": "Authorization", "value": "Bearer {api_token}", "is_secret": true}]}
  ]
}
